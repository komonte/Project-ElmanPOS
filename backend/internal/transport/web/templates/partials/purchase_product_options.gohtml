{{- /* Resultados del buscador de producto de un renglón (PurchasesProductOptions).
     Elegir uno llama a purchasePickProduct (página de compras). Sin
     resultados, ofrece dar de alta lo escrito (purchaseQuickProduct). Sin espacios
     sueltos: si no hay nada, la lista queda vacía y :empty la oculta. */ -}}
{{- range .Products}}
<li role="option">
  <button type="button" data-id="{{.ID}}" data-name="{{.Name}}" data-batches="{{.ControlsBatches}}"
          onclick="purchasePickProduct(this)"
          class="block w-full text-left px-3 py-2 hover:bg-paper focus:bg-paper">
    {{.Name}} <span class="text-sm text-muted">· {{.SKU}}{{if .ControlsBatches}} · {{t "purchase.controls_batches"}}{{end}}</span>
  </button>
</li>
{{- end}}
{{- if and .Query (not .Products)}}
<li class="px-3 py-2 text-muted">{{t "purchase.product_not_found"}}</li>
<li>
  <button type="button" data-quick-product data-q="{{.Query}}" onclick="purchaseQuickProduct(this)"
          class="block w-full text-left px-3 py-2 font-bold hover:bg-paper focus:bg-paper">{{printf (t "purchase.quick_offer") .Query}}</button>
</li>
{{- end -}}
