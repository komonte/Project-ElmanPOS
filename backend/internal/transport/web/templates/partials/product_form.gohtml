{{/* Panel lateral, igual que el de categorías. Los campos van en grupos
     (qué es, dónde va, cómo se vende, stock y precio) para que un formulario
     largo se lea de a partes. Los <select> de categoría, marca y proveedor
     traen solo los activos, más el actual aunque esté inactivo. */}}
<div class="fixed inset-0 z-50 flex justify-end bg-ink/40" onclick="if (event.target === this) closeModal()">
  <div class="h-full w-full sm:max-w-lg bg-surface border-l-8 border-tag overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="form-title">
    <div class="flex items-start justify-between gap-4 px-6 pt-6 pb-4 border-b-2 border-line">
      <h2 id="form-title" class="font-display font-bold text-3xl leading-tight">{{if .Product.ID}}{{t "product.edit"}}{{else}}{{t "product.create"}}{{end}}</h2>
      <button type="button" onclick="closeModal()" aria-label="{{t "common.close"}}"
              class="-mr-2 px-2 text-3xl leading-none text-muted hover:text-ink">&times;</button>
    </div>
    <div class="px-6 py-6">
      {{if .Error}}
      <div role="alert" class="mb-6 p-4 bg-danger-soft border-l-8 border-danger rounded-sm font-bold">{{.Error}}</div>
      {{end}}
      <form hx-post="{{if .Product.ID}}/products/{{.Product.ID}}/edit{{else}}/products/new{{end}}"
            hx-target="#form-modal" hx-swap="innerHTML"
            class="space-y-8">

        <fieldset class="space-y-5">
          <legend class="font-display font-bold text-2xl mb-3">{{t "product.group_identity"}}</legend>
          {{/* El código interno lo genera la DB al crear (no hay campo). Al
               editar se muestra como texto: el formulario no lo manda y el
               store conserva el que tiene. */}}
          {{if .Product.ID}}
          <div>
            <span class="field-label">{{t "product.sku"}}</span>
            <p class="font-display font-bold text-2xl leading-none tabular">{{.Product.SKU}}</p>
            <span class="field-hint">{{t "product.sku_hint"}}</span>
          </div>
          {{end}}
          {{/* Código de barras: solo en el alta, y primero (con el foco): se
               escanea antes de llenar nada. Al escanear (Enter) o al salir del
               campo se revisa: si ya es de un producto, avisa y ofrece editar
               ese. Si está libre y el cursor sigue acá, pasa al nombre.
               El Enter no guarda el formulario a medio llenar.
               Al editar, los códigos tienen su propia sección. */}}
          {{if not .Product.ID}}
          <div>
            <label for="product-barcode" class="field-label">{{t "product.barcode"}}</label>
            <input type="text" id="product-barcode" name="barcode" inputmode="numeric" autocomplete="off" maxlength="20" autofocus
                   aria-describedby="product-barcode-hint" value="{{.Barcode}}"
                   onkeydown="if (event.key === 'Enter') event.preventDefault();"
                   hx-get="/products/barcode-check" hx-trigger="keyup[key=='Enter'], change"
                   hx-target="#product-barcode-check" hx-swap="innerHTML" hx-sync="this:replace"
                   class="field max-w-60 tabular">
            <span id="product-barcode-hint" class="field-hint">{{t "product.barcode_hint"}}</span>
            <div id="product-barcode-check" aria-live="polite"
                 hx-on::after-swap="if (!this.querySelector('[role=alert]') && document.activeElement && document.activeElement.id === 'product-barcode') document.getElementById('product-name').focus();"></div>
          </div>
          {{end}}
          <div>
            <label for="product-name" class="field-label">{{t "product.name"}} <span class="font-normal text-muted">{{t "common.required"}}</span></label>
            <input type="text" id="product-name" name="name" {{if .Product.ID}}autofocus{{end}} required maxlength="200"
                   value="{{.Product.Name}}" class="field uppercase">
          </div>
          <div>
            <label for="product-description" class="field-label">{{t "common.description"}}</label>
            <input type="text" id="product-description" name="description" maxlength="500"
                   value="{{.Product.Description}}" class="field">
          </div>
        </fieldset>

        <fieldset class="space-y-5">
          <legend class="font-display font-bold text-2xl mb-3">{{t "product.group_classification"}}</legend>
          <div>
            <label for="product-category" class="field-label">{{t "product.category"}} <span class="font-normal text-muted">{{t "common.required"}}</span></label>
            <select id="product-category" name="category_id" required aria-describedby="product-category-hint" class="field">
              <option value="" disabled {{if not .Product.CategoryID}}selected{{end}}>{{t "product.category_choose"}}</option>
              {{range .Categories}}
              <option value="{{.ID}}" {{if .Selected}}selected{{end}}>{{.Label}}{{if .Inactive}} {{t "product.inactive_suffix"}}{{end}}</option>
              {{end}}
            </select>
            <span id="product-category-hint" class="field-hint">{{t "product.category_hint"}}</span>
          </div>
          {{/* Marca: hay miles, así que en vez de un <select> es un buscador.
               brand_q es lo que se escribe; brand_id (oculto) es la marca
               elegida de la lista. Escribir borra la elegida: hay que volver
               a elegir una (o dejarlo vacío para "sin marca").
               En el alta, la lista ofrece crear la marca si no existe:
               brand_new (oculto) es su nombre, y se crea al guardar. */}}
          <div>
            <label for="product-brand" class="field-label">{{t "product.brand"}}</label>
            <input type="hidden" name="brand_id" value="{{with .Product.BrandID}}{{.}}{{end}}">
            <input type="hidden" name="brand_new" value="{{.BrandNew}}">
            <input type="search" id="product-brand" name="brand_q" autocomplete="off"
                   aria-autocomplete="list" aria-controls="product-brand-options"
                   aria-describedby="product-brand-hint"
                   value="{{if .BrandNew}}{{.BrandNew}}{{else}}{{.BrandName}}{{end}}" placeholder="{{t "product.brand_search"}}"
                   hx-get="/products/brand-options{{if not .Product.ID}}?new=1{{end}}" hx-trigger="input changed delay:250ms" hx-target="#product-brand-options"
                   oninput="this.form.elements.brand_id.value = ''; this.form.elements.brand_new.value = ''; document.getElementById('product-brand-new').hidden = true;"
                   class="field">
            <p id="product-brand-new" class="mt-1 text-sm font-bold text-tag" {{if not .BrandNew}}hidden{{end}}>{{t "product.brand_new_note"}}</p>
            <ul id="product-brand-options" role="listbox" class="mt-1 border-2 border-line rounded-md bg-surface empty:hidden max-h-64 overflow-y-auto"></ul>
            <span id="product-brand-hint" class="field-hint">{{if .BrandInactive}}{{t "product.brand_inactive_hint"}}{{else}}{{t "product.brand_hint"}}{{end}}</span>
          </div>
          <div>
            <label for="product-supplier" class="field-label">{{t "product.supplier"}}</label>
            <select id="product-supplier" name="preferred_supplier_id" aria-describedby="product-supplier-hint" class="field">
              <option value="">{{t "product.none"}}</option>
              {{range .Suppliers}}
              <option value="{{.ID}}" {{if .Selected}}selected{{end}}>{{.Label}}{{if .Inactive}} {{t "product.inactive_suffix"}}{{end}}</option>
              {{end}}
            </select>
            <span id="product-supplier-hint" class="field-hint">{{t "product.supplier_hint"}}</span>
          </div>
        </fieldset>

        <fieldset class="space-y-5">
          <legend class="font-display font-bold text-2xl mb-1">{{t "product.group_sale"}}</legend>
          <p class="text-sm text-muted">{{t "product.locked_hint"}}</p>
          <div class="flex flex-wrap gap-4">
            <div>
              <label for="product-sale-type" class="field-label">{{t "product.sale_type"}}</label>
              {{/* A granel siempre va por kg: al elegirlo, la unidad pasa a KILOGRAM. */}}
              <select id="product-sale-type" name="sale_type" class="field max-w-60"
                      onchange="if (this.value === 'WEIGHT') this.form.elements.measure_unit.value = 'KILOGRAM';">
                {{$current := .Product.SaleType}}
                {{range .SaleTypes}}
                <option value="{{.}}" {{if eq . $current}}selected{{end}}>{{t (printf "product.sale_type_%s" .)}}</option>
                {{end}}
              </select>
            </div>
            <div>
              <label for="product-measure-unit" class="field-label">{{t "product.measure_unit"}}</label>
              <select id="product-measure-unit" name="measure_unit" class="field max-w-60">
                {{$current := .Product.MeasureUnit}}
                {{range .MeasureUnits}}
                <option value="{{.}}" {{if eq . $current}}selected{{end}}>{{t (printf "product.measure_unit_%s" .)}}</option>
                {{end}}
              </select>
            </div>
          </div>
          <label class="flex items-start gap-3">
            <input type="checkbox" name="controls_batches" {{if .Product.ControlsBatches}}checked{{end}} class="mt-1 size-5 accent-ink">
            <span><span class="font-bold">{{t "product.controls_batches"}}</span>
              <span class="block text-sm text-muted">{{t "product.controls_batches_hint"}}</span></span>
          </label>
          <label class="flex items-start gap-3">
            <input type="checkbox" name="is_consignment" {{if .Product.IsConsignment}}checked{{end}} class="mt-1 size-5 accent-ink">
            <span><span class="font-bold">{{t "product.is_consignment"}}</span>
              <span class="block text-sm text-muted">{{t "product.is_consignment_hint"}}</span></span>
          </label>
        </fieldset>

        <fieldset class="space-y-5">
          <legend class="font-display font-bold text-2xl mb-3">{{t "product.group_stock"}}</legend>
          <div class="flex flex-wrap gap-4">
            <div>
              <label for="product-reorder-point" class="field-label">{{t "product.reorder_point"}}</label>
              <input type="text" id="product-reorder-point" name="reorder_point" inputmode="decimal" aria-describedby="product-reorder-point-hint"
                     value="{{.Product.ReorderPoint}}" class="field max-w-40 tabular">
            </div>
            <div>
              <label for="product-max-stock" class="field-label">{{t "product.max_stock"}}</label>
              <input type="text" id="product-max-stock" name="max_stock" inputmode="decimal" aria-describedby="product-max-stock-hint"
                     value="{{with .Product.MaxStock}}{{.}}{{end}}" class="field max-w-40 tabular">
            </div>
          </div>
          <span id="product-reorder-point-hint" class="field-hint">{{t "product.reorder_point_hint"}}</span>
          <span id="product-max-stock-hint" class="field-hint">{{t "product.max_stock_hint"}}</span>
        </fieldset>

        <fieldset class="space-y-5">
          <legend class="font-display font-bold text-2xl mb-3">{{t "product.group_price"}}</legend>
          <div>
            <label for="product-margin" class="field-label">{{t "product.margin_percent"}}</label>
            <input type="text" id="product-margin" name="margin_percent" inputmode="decimal" aria-describedby="product-margin-hint"
                   value="{{.Product.MarginPercent}}" class="field max-w-40 tabular">
            <span id="product-margin-hint" class="field-hint">{{t "product.margin_hint"}}</span>
          </div>
        </fieldset>

        <div class="flex flex-wrap gap-3 pt-4">
          <button type="submit" class="btn-primary">{{t "common.save"}}</button>
          <button type="button" onclick="closeModal()" class="btn-secondary">{{t "common.cancel"}}</button>
        </div>
      </form>
      {{/* Al editar: los códigos de barra, fuera del <form> del producto. */}}
      {{if .Product.ID}}
      {{template "product_codes.gohtml" (dict "ProductID" .Product.ID "Codes" .Codes)}}
      {{end}}
    </div>
  </div>
</div>
