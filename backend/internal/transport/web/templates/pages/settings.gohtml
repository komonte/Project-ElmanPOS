{{define "content"}}
{{/* Configuración del negocio (solo el admin). Datos: .Settings
     (settings.Settings), .Saved, .Error, .UnstockedCount (vendidos sin
     stock que faltan contar) y .RoundingOptions (los múltiplos que se
     pueden elegir). */}}
<header class="mb-8">
  <h1 class="shelf-title">{{t "settings.title"}}</h1>
  <p class="mt-4 text-lg text-muted max-w-2xl">{{t "settings.hint"}}</p>
</header>

{{if .Error}}
<div role="alert" class="mb-6 p-4 bg-danger-soft border-l-8 border-danger rounded-sm font-bold max-w-3xl">{{.Error}}</div>
{{end}}
{{if .Saved}}
<div id="settings-saved" role="status" class="mb-6 p-4 bg-surface border-l-8 border-stock rounded-sm font-bold max-w-3xl">{{t "settings.saved"}}</div>
{{end}}

{{with .Settings}}
<section id="settings-startup" aria-labelledby="startup-heading"
         class="max-w-3xl p-5 bg-surface border-2 {{if .StartupMode}}border-tag-deep{{else}}border-line{{end}} rounded-md">
  <h2 id="startup-heading" class="font-display font-bold text-3xl leading-none">{{t "settings.startup_title"}}</h2>
  <p class="mt-3 text-muted">{{t "settings.startup_hint"}}</p>
  <p id="startup-state" data-on="{{if .StartupMode}}true{{else}}false{{end}}" class="mt-4 text-lg font-bold">
    <span aria-hidden="true" class="inline-block w-3 h-3 mr-2 rounded-full {{if .StartupMode}}bg-tag-deep{{else}}bg-muted{{end}}"></span>{{if .StartupMode}}{{t "settings.startup_on"}}{{else}}{{t "settings.startup_off"}}{{end}}
  </p>
  {{if and .StartupMode $.UnstockedCount}}
  <p class="mt-2 text-muted">{{printf (t "settings.startup_off_pending") $.UnstockedCount}}</p>
  {{end}}
  <form method="post" action="/settings/startup-mode" class="mt-5">
    {{if .StartupMode}}
    <button type="submit" id="startup-toggle" class="btn-secondary">{{t "settings.startup_turn_off"}}</button>
    {{else}}
    <input type="hidden" name="startup_mode" value="on">
    <button type="submit" id="startup-toggle" class="btn-primary">{{t "settings.startup_turn_on"}}</button>
    {{end}}
  </form>
</section>

{{/* Redondeo en efectivo (0024): el múltiplo, de una lista fija. */}}
<section id="settings-rounding" aria-labelledby="rounding-heading"
         class="mt-6 max-w-3xl p-5 bg-surface border-2 border-line rounded-md">
  <h2 id="rounding-heading" class="font-display font-bold text-3xl leading-none">{{t "settings.rounding_title"}}</h2>
  <p class="mt-3 text-muted">{{t "settings.rounding_hint"}}</p>
  <form method="post" action="/settings/cash-rounding" class="mt-5 flex flex-wrap items-end gap-3">
    <div>
      <label for="rounding-multiple" class="field-label">{{t "settings.rounding_multiple"}}</label>
      <select id="rounding-multiple" name="multiple" class="field">
        {{$current := .CashRounding}}
        {{range $.RoundingOptions}}
        <option value="{{.Value}}" {{if eq .Value $current}}selected{{end}}>{{if eq .Value 0}}{{t "settings.rounding_off"}}{{else}}{{printf (t "settings.rounding_to") (money .Amount)}}{{end}}</option>
        {{end}}
      </select>
    </div>
    <button type="submit" id="rounding-save" class="btn-primary">{{t "common.save"}}</button>
  </form>
</section>
{{end}}
{{end}}
