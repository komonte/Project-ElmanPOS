<nav class="bg-white border-b border-gray-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16">
      <div class="flex items-center gap-8">
        <a href="/" class="text-xl font-bold text-indigo-600 tracking-tight">{{t "app.title"}}</a>
        <div class="hidden md:flex items-center gap-1">
          <a href="/" class="px-3 py-2 rounded-md text-sm font-medium {{if eq .Section "dashboard"}}bg-indigo-50 text-indigo-700{{else}}text-gray-600 hover:text-gray-900 hover:bg-gray-100{{end}}">
            {{t "nav.dashboard"}}
          </a>
          <a href="/brands" class="px-3 py-2 rounded-md text-sm font-medium {{if eq .Section "brands"}}bg-indigo-50 text-indigo-700{{else}}text-gray-600 hover:text-gray-900 hover:bg-gray-100{{end}}">
            {{t "nav.brands"}}
          </a>
          <a href="/taxes" class="px-3 py-2 rounded-md text-sm font-medium {{if eq .Section "taxes"}}bg-indigo-50 text-indigo-700{{else}}text-gray-600 hover:text-gray-900 hover:bg-gray-100{{end}}">
            {{t "nav.taxes"}}
          </a>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <form hx-post="/settings/language" hx-trigger="change" hx-swap="none" class="flex items-center gap-1">
          <label for="lang-select" class="text-xs text-gray-500">{{t "language.select"}}:</label>
          <select id="lang-select" name="lang" onchange="this.form.requestSubmit()"
                  class="text-sm border border-gray-300 rounded-md px-2 py-1 bg-white focus:outline-none focus:ring-1 focus:ring-indigo-500">
            <option value="en" {{if eq .Lang "en"}}selected{{end}}>{{t "language.en"}}</option>
            <option value="es" {{if eq .Lang "es"}}selected{{end}}>{{t "language.es"}}</option>
          </select>
        </form>
      </div>
    </div>
  </div>
</nav>