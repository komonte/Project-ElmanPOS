# ---- Binarios y salida de build ----
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
/dist/
/build/

# Cobertura de tests
coverage.out
*.coverprofile

# ---- Entorno y secretos ----
.env
.env.*
!.env.example
!.env.*.example

# ---- Certificados HTTPS (mkcert): la clave nunca va al repo ----
*.pem
*.key
*.crt

# ---- Datos locales ----
# Nada de datos en el repo: dumps, catálogos y CSV/ZIP del dataset SEPA viven
# fuera (../productos_dataset). Solo se versiona el código que los procesa.
data/
*.dump
*.sql.gz
*.csv
*.zip
catalog_*.sql

# ---- Editor y sistema operativo ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
