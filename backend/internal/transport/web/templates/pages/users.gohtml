{{define "content"}}
<header class="flex flex-wrap items-end justify-between gap-4 mb-8">
  <div>
    <h1 class="shelf-title">{{t "user.title"}}</h1>
    <p class="mt-4 text-lg text-muted max-w-2xl">{{t "user.hint"}}</p>
  </div>
  <button id="user-new" hx-get="/users/new" hx-target="#form-modal" hx-swap="innerHTML" class="btn-primary">
    <span aria-hidden="true" class="text-2xl leading-none">+</span>{{t "user.create"}}
  </button>
</header>

<div id="form-modal"></div>

<div id="users-table" class="overflow-x-auto bg-surface border-2 border-line rounded-md">
  {{template "user_table.gohtml" .}}
</div>
{{end}}
