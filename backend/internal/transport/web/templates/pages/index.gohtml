{{define "content"}}
<header class="mb-8">
  <h1 class="shelf-title">{{t "nav.dashboard"}}</h1>
  <p class="mt-4 text-lg text-muted">{{t "app.tagline"}}</p>
</header>

{{/* Modo arranque: que se vea que está prendido y, para quien cuenta,
     cuánto falta contar. */}}
{{if or .StartupMode .UnstockedCount}}
<section id="startup-banner" aria-labelledby="startup-heading" class="max-w-2xl mb-8 p-4 bg-surface border-l-8 border-tag-deep rounded-sm">
  {{if .StartupMode}}
  <h2 id="startup-heading" class="font-display font-bold text-3xl leading-none">{{t "dashboard.startup_title"}}</h2>
  <p class="mt-2 text-muted">{{t "dashboard.startup_text"}}</p>
  {{end}}
  {{with .UnstockedCount}}
  <p class="mt-3 text-lg"><a href="/reports/unstocked" data-pending="unstocked" class="font-bold underline underline-offset-4">{{if eq . 1}}{{t "dashboard.startup_pending_one"}}{{else}}{{printf (t "dashboard.startup_pending") .}}{{end}}</a></p>
  {{end}}
</section>
{{end}}

{{/* Precios pendientes (F-06): solo para quien pone precios y si hay algo. */}}
{{with .Pending}}{{if or .MissingPrices .UnpricedPurchases}}
<section id="pending-prices" aria-labelledby="pending-heading" class="max-w-2xl mb-8 p-4 bg-danger-soft border-l-8 border-danger rounded-sm">
  <h2 id="pending-heading" class="font-display font-bold text-3xl leading-none">{{t "price.pending_title"}}</h2>
  <ul class="mt-3 space-y-2 text-lg">
    {{if .MissingPrices}}<li><a href="/prices/missing" data-pending="missing" class="font-bold underline underline-offset-4">{{if eq .MissingPrices 1}}{{t "price.pending_missing_one"}}{{else}}{{printf (t "price.pending_missing") .MissingPrices}}{{end}}</a></li>{{end}}
    {{if .UnpricedPurchases}}<li><a href="/purchases/history?unpriced=1" data-pending="purchases" class="font-bold underline underline-offset-4">{{if eq .UnpricedPurchases 1}}{{t "price.pending_purchases_one"}}{{else}}{{printf (t "price.pending_purchases") .UnpricedPurchases}}{{end}}</a></li>{{end}}
  </ul>
</section>
{{end}}{{end}}

{{/* Solo lo que el rol puede abrir: el catálogo (sin impuestos para el
     repositor). El cajero entra directo a vender. */}}
{{if can .Can "catalog"}}
<section aria-labelledby="catalog-heading" class="max-w-2xl">
  <h2 id="catalog-heading" class="font-display font-bold text-3xl leading-none">{{t "nav.group_catalog"}}</h2>
  <p class="mt-1 mb-3 text-muted">{{t "dashboard.active_counts"}}</p>
  <ul class="bg-surface border-2 border-line rounded-md divide-y-2 divide-line">
    {{template "dashboard-row" (dict "Href" "/categories" "Label" (t "nav.categories") "Count" .CategoryCount)}}
    {{template "dashboard-row" (dict "Href" "/brands" "Label" (t "nav.brands") "Count" .BrandCount)}}
    {{if can .Can "prices"}}{{template "dashboard-row" (dict "Href" "/taxes" "Label" (t "nav.taxes") "Count" .TaxCount)}}{{end}}
    {{template "dashboard-row" (dict "Href" "/suppliers" "Label" (t "nav.suppliers") "Count" .SupplierCount)}}
  </ul>
</section>
{{end}}
{{end}}

{{define "dashboard-row"}}
<li>
  <a href="{{.Href}}" class="flex items-center justify-between gap-4 px-5 py-4 hover:bg-paper">
    <span class="text-lg font-bold">{{.Label}}</span>
    <span class="font-display font-bold text-4xl leading-none tabular">{{.Count}}</span>
  </a>
</li>
{{end}}
