<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{t "app.title"}}{{if .TitleKey}} - {{t .TitleKey}}{{end}}</title>
  <link rel="stylesheet" href="/static/css/output.css">
  <script src="/static/js/htmx.min.js" defer></script>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">
  {{template "nav.gohtml" .}}

  <main class="flex-1 p-6 max-w-7xl mx-auto w-full">
    {{template "content" .}}
  </main>

  {{/* Aviso para errores de acciones htmx (borrar, desactivar...). htmx no
       dibuja las respuestas 4xx/5xx, así que sin esto el botón parecería
       no hacer nada. El texto lo manda el servidor, ya traducido. */}}
  <div id="toast" role="alert" hidden
       data-network-error="{{t "error.network"}}"
       class="fixed bottom-4 left-1/2 -translate-x-1/2 z-50 max-w-md w-[calc(100%-2rem)] p-4 pr-10 bg-red-50 border border-red-200 rounded-lg text-sm text-red-800 shadow-lg">
    <span id="toast-text"></span>
    <button type="button" aria-label="{{t "common.close"}}" onclick="this.parentElement.hidden = true"
            class="absolute top-2 right-3 text-red-400 hover:text-red-600 text-lg leading-none">&times;</button>
  </div>
  <script>
    // Los formularios se abren en #form-modal; vaciarlo lo cierra.
    function closeModal() {
      document.getElementById('form-modal').innerHTML = '';
    }
    document.addEventListener('keydown', function (e) {
      var modal = document.getElementById('form-modal');
      if (e.key === 'Escape' && modal && modal.firstElementChild) {
        closeModal();
      }
    });

    (function () {
      var toast = document.getElementById('toast');
      var timer;
      function show(msg) {
        document.getElementById('toast-text').textContent = msg;
        toast.hidden = false;
        clearTimeout(timer);
        timer = setTimeout(function () { toast.hidden = true; }, 8000);
      }
      document.addEventListener('htmx:responseError', function (e) {
        show(e.detail.xhr.responseText.trim() || e.detail.xhr.statusText);
      });
      document.addEventListener('htmx:sendError', function () {
        show(toast.dataset.networkError);
      });
    })();
  </script>

  <footer class="text-center text-xs text-gray-400 py-4 border-t">
    {{t "app.title"}} v0.1.0
  </footer>
</body>
</html>
