{{define "content"}}
{{/* Compras recibidas (F-06): las facturas, la más nueva arriba, con el
     estado de sus precios. Datos: .Purchases (model.PurchaseSummary),
     .OnlyUnpriced y .Limit. */}}
<header class="flex flex-wrap items-end justify-between gap-4 mb-6">
  <div>
    <h1 class="shelf-title">{{t "purchase.history_title"}}</h1>
    <p class="mt-4 text-lg text-muted max-w-2xl">{{t "purchase.history_hint"}}</p>
  </div>
  <a href="/purchases" class="btn-primary">{{t "purchase.receive_new"}}</a>
</header>

<nav aria-label="{{t "purchase.history_filter"}}" class="mb-6 flex flex-wrap gap-2">
  <a href="/purchases/history" data-filter="all" {{if not .OnlyUnpriced}}aria-current="true"{{end}}
     class="px-3 py-1 rounded-md border-2 font-bold {{if not .OnlyUnpriced}}border-ink bg-ink text-white{{else}}border-line bg-surface hover:border-ink{{end}}">{{t "purchase.history_all"}}</a>
  <a href="/purchases/history?unpriced=1" data-filter="unpriced" {{if .OnlyUnpriced}}aria-current="true"{{end}}
     class="px-3 py-1 rounded-md border-2 font-bold {{if .OnlyUnpriced}}border-ink bg-ink text-white{{else}}border-line bg-surface hover:border-ink{{end}}">{{t "purchase.history_unpriced"}}</a>
</nav>

<div class="overflow-x-auto bg-surface border-2 border-line rounded-md">
  <table id="purchase-history" class="min-w-full text-left">
    <thead class="border-b-2 border-line text-muted">
      <tr>
        <th scope="col" class="px-3 py-3 font-bold whitespace-nowrap">{{t "purchase.col_received"}}</th>
        <th scope="col" class="px-3 py-3 font-bold">{{t "purchase.supplier"}}</th>
        <th scope="col" class="px-3 py-3 font-bold whitespace-nowrap">{{t "purchase.col_voucher"}}</th>
        <th scope="col" class="px-3 py-3 font-bold whitespace-nowrap text-right">{{t "purchase.col_products"}}</th>
        <th scope="col" class="px-3 py-3 font-bold whitespace-nowrap text-right">{{t "purchase.col_total"}}</th>
        <th scope="col" class="px-3 py-3 font-bold whitespace-nowrap">{{t "purchase.col_prices"}}</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-line">
      {{range .Purchases}}
      <tr data-purchase="{{.ID}}" class="hover:bg-paper">
        <td class="px-3 py-2 whitespace-nowrap">
          <a href="/purchases/{{.ID}}" class="font-bold underline-offset-4 hover:underline">{{formatTime .ReceivedAt}}</a>
          <span class="block text-sm text-muted">{{t "purchase.received_by"}} {{who .ReceivedByName}}</span>
        </td>
        <td class="px-3 py-2">{{.SupplierName}}</td>
        <td class="px-3 py-2 whitespace-nowrap">{{if .VoucherNumber}}{{.VoucherNumber}}{{else}}—{{end}}</td>
        <td class="px-3 py-2 text-right tabular">{{.Products}}</td>
        <td class="px-3 py-2 text-right tabular whitespace-nowrap">{{money .Total}}</td>
        <td class="px-3 py-2 whitespace-nowrap" data-unpriced="{{.Unpriced}}">
          {{if .Unpriced}}<a href="/purchases/{{.ID}}" class="inline-block px-2 py-0.5 rounded-sm bg-danger-soft text-danger font-bold">{{if eq .Unpriced 1}}{{t "purchase.unpriced_one"}}{{else}}{{printf (t "purchase.unpriced") .Unpriced}}{{end}}</a>
          {{else}}<span class="text-stock font-bold">✓ {{t "purchase.priced"}}</span>{{end}}
        </td>
      </tr>
      {{else}}
      <tr><td colspan="6" class="px-4 py-10 text-center text-muted">{{if .OnlyUnpriced}}{{t "purchase.history_none_unpriced"}}{{else}}{{t "purchase.history_none"}}{{end}}</td></tr>
      {{end}}
    </tbody>
  </table>
</div>
{{if ge (len .Purchases) .Limit}}<p class="mt-3 text-muted">{{printf (t "purchase.history_limit") .Limit}}</p>{{end}}
{{end}}
