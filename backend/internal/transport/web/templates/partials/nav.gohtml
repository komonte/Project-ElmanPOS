<nav class="bg-white border-b border-gray-200 shadow-sm">
  {{/* En pantallas chicas los links bajan a su propia fila y se pueden
       deslizar de costado; desde md quedan en línea con el logo. */}}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 md:py-0 md:h-16 flex flex-wrap md:flex-nowrap items-center justify-between gap-x-8 gap-y-2">
    <a href="/" class="text-xl font-bold text-indigo-600 tracking-tight">{{t "app.title"}}</a>

    <div class="order-last md:order-none w-full md:w-auto md:flex-1 flex items-center gap-1 overflow-x-auto">
      <a href="/" {{if eq .Section "dashboard"}}aria-current="page"{{end}}
         class="px-3 py-2 rounded-md text-sm font-medium whitespace-nowrap {{if eq .Section "dashboard"}}bg-indigo-50 text-indigo-700{{else}}text-gray-600 hover:text-gray-900 hover:bg-gray-100{{end}}">{{t "nav.dashboard"}}</a>
      <a href="/brands" {{if eq .Section "brands"}}aria-current="page"{{end}}
         class="px-3 py-2 rounded-md text-sm font-medium whitespace-nowrap {{if eq .Section "brands"}}bg-indigo-50 text-indigo-700{{else}}text-gray-600 hover:text-gray-900 hover:bg-gray-100{{end}}">{{t "nav.brands"}}</a>
      <a href="/taxes" {{if eq .Section "taxes"}}aria-current="page"{{end}}
         class="px-3 py-2 rounded-md text-sm font-medium whitespace-nowrap {{if eq .Section "taxes"}}bg-indigo-50 text-indigo-700{{else}}text-gray-600 hover:text-gray-900 hover:bg-gray-100{{end}}">{{t "nav.taxes"}}</a>
      <a href="/suppliers" {{if eq .Section "suppliers"}}aria-current="page"{{end}}
         class="px-3 py-2 rounded-md text-sm font-medium whitespace-nowrap {{if eq .Section "suppliers"}}bg-indigo-50 text-indigo-700{{else}}text-gray-600 hover:text-gray-900 hover:bg-gray-100{{end}}">{{t "nav.suppliers"}}</a>
    </div>

    <div class="flex items-center gap-2">
      <label for="lang-select" class="text-xs text-gray-500">{{t "language.select"}}</label>
      <select id="lang-select" name="lang"
              hx-post="/settings/language" hx-trigger="change" hx-swap="none"
              class="text-sm border border-gray-300 rounded-md px-2 py-1 bg-white focus:outline-none focus:ring-1 focus:ring-indigo-500">
        <option value="en" {{if eq .Lang "en"}}selected{{end}}>{{t "language.en"}}</option>
        <option value="es" {{if eq .Lang "es"}}selected{{end}}>{{t "language.es"}}</option>
      </select>
    </div>
  </div>
</nav>
