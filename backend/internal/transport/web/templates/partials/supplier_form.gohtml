{{/* Panel lateral: el formulario entra desde la derecha y la tabla queda
     visible atrás. En celular ocupa toda la pantalla. */}}
<div class="fixed inset-0 z-50 flex justify-end bg-ink/40" onclick="if (event.target === this) closeModal()">
  <div class="h-full w-full sm:max-w-lg bg-surface border-l-8 border-tag overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="form-title">
    <div class="flex items-start justify-between gap-4 px-6 pt-6 pb-4 border-b-2 border-line">
      <h2 id="form-title" class="font-display font-bold text-3xl leading-tight">{{if .Supplier.ID}}{{t "supplier.edit"}}{{else}}{{t "supplier.create"}}{{end}}</h2>
      <button type="button" onclick="closeModal()" aria-label="{{t "common.close"}}"
              class="-mr-2 px-2 text-3xl leading-none text-muted hover:text-ink">&times;</button>
    </div>
    <div class="px-6 py-6">
      {{if .Error}}
      <div role="alert" class="mb-6 p-4 bg-danger-soft border-l-8 border-danger rounded-sm font-bold">{{.Error}}</div>
      {{end}}
      <form hx-post="{{if .Supplier.ID}}/suppliers/{{.Supplier.ID}}/edit{{else}}/suppliers/new{{end}}"
            hx-target="#form-modal" hx-swap="innerHTML"
            class="space-y-5">
        <div>
          <label for="supplier-name" class="field-label">{{t "supplier.name"}} <span class="font-normal text-muted">{{t "common.required"}}</span></label>
          <input type="text" id="supplier-name" name="name" autofocus required maxlength="160"
                 value="{{if .Supplier}}{{.Supplier.Name}}{{end}}" class="field">
        </div>
        <div>
          <label for="supplier-tax-id-number" class="field-label">{{t "supplier.tax_id_number"}}</label>
          <input type="text" id="supplier-tax-id-number" name="tax_id_number" inputmode="numeric" placeholder="20-12345678-6" aria-describedby="supplier-tax-id-number-hint"
                 value="{{if .Supplier}}{{.Supplier.TaxIDNumber}}{{end}}" class="field max-w-60">
          <span id="supplier-tax-id-number-hint" class="field-hint">{{t "supplier.tax_id_hint"}}</span>
        </div>
        <div>
          <label for="supplier-phone" class="field-label">{{t "supplier.phone"}}</label>
          <input type="tel" id="supplier-phone" name="phone" maxlength="40"
                 value="{{if .Supplier}}{{.Supplier.Phone}}{{end}}" class="field">
        </div>
        <div>
          <label for="supplier-email" class="field-label">{{t "supplier.email"}}</label>
          <input type="email" id="supplier-email" name="email" maxlength="120"
                 value="{{if .Supplier}}{{.Supplier.Email}}{{end}}" class="field">
        </div>
        <div>
          <label for="supplier-payment-terms" class="field-label">{{t "supplier.payment_terms"}}</label>
          <input type="text" id="supplier-payment-terms" name="payment_terms" maxlength="120" aria-describedby="supplier-payment-terms-hint"
                 value="{{if .Supplier}}{{.Supplier.PaymentTerms}}{{end}}" class="field">
          <span id="supplier-payment-terms-hint" class="field-hint">{{t "supplier.payment_terms_hint"}}</span>
        </div>
        <div class="flex flex-wrap gap-3 pt-4">
          <button type="submit" class="btn-primary">{{t "common.save"}}</button>
          <button type="button" onclick="closeModal()" class="btn-secondary">{{t "common.cancel"}}</button>
        </div>
      </form>
    </div>
        </div>
</div>
