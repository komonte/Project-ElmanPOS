{{define "content"}}
<header class="flex flex-wrap items-end justify-between gap-4 mb-8">
  <h1 class="shelf-title">{{t "tax.title"}}</h1>
  <button hx-get="/taxes/new" hx-target="#form-modal" hx-swap="innerHTML" class="btn-primary">
    <span aria-hidden="true" class="text-2xl leading-none">+</span>{{t "tax.create"}}
  </button>
</header>

<div id="form-modal"></div>

<div class="mb-4">
  <label for="search" class="sr-only">{{t "common.search"}}</label>
  <input id="search" type="search" name="search" placeholder="{{t "common.search"}}"
         hx-get="/taxes" hx-trigger="input changed delay:300ms, search" hx-target="#taxes-table" hx-swap="innerHTML"
         class="field max-w-sm">
</div>

<div id="taxes-table" class="overflow-x-auto bg-surface border-2 border-line rounded-md">
  {{template "tax_table.gohtml" .}}
</div>
{{end}}
