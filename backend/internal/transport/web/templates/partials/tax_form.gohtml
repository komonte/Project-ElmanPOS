{{/* Panel lateral: el formulario entra desde la derecha y la tabla queda
     visible atrás. En celular ocupa toda la pantalla. */}}
<div class="fixed inset-0 z-50 flex justify-end bg-ink/40" onclick="if (event.target === this) closeModal()">
  <div class="h-full w-full sm:max-w-lg bg-surface border-l-8 border-tag overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="form-title">
    <div class="flex items-start justify-between gap-4 px-6 pt-6 pb-4 border-b-2 border-line">
      <h2 id="form-title" class="font-display font-bold text-3xl leading-tight">{{if .Tax.ID}}{{t "tax.edit"}}{{else}}{{t "tax.create"}}{{end}}</h2>
      <button type="button" onclick="closeModal()" aria-label="{{t "common.close"}}"
              class="-mr-2 px-2 text-3xl leading-none text-muted hover:text-ink">&times;</button>
    </div>
    <div class="px-6 py-6">
      {{if .Error}}
      <div role="alert" class="mb-6 p-4 bg-danger-soft border-l-8 border-danger rounded-sm font-bold">{{.Error}}</div>
      {{end}}
      <form hx-post="{{if .Tax.ID}}/taxes/{{.Tax.ID}}/edit{{else}}/taxes/new{{end}}"
            hx-target="#form-modal" hx-swap="innerHTML"
            class="space-y-5">
        <div>
          <label for="tax-name" class="field-label">{{t "tax.name"}} <span class="font-normal text-muted">{{t "common.required"}}</span></label>
          <input type="text" id="tax-name" name="name" autofocus required maxlength="80"
                 value="{{if .Tax}}{{.Tax.Name}}{{end}}" class="field">
        </div>
        <div>
          <label for="tax-rate" class="field-label">{{t "tax.rate"}} <span class="font-normal text-muted">{{t "common.required"}}</span></label>
          <input type="number" id="tax-rate" name="rate" required step="0.01" min="0" max="100" inputmode="decimal"
                 value="{{if .Tax}}{{.Tax.Rate}}{{end}}" class="field max-w-40">
        </div>
        <div class="flex flex-wrap gap-3 pt-4">
          <button type="submit" class="btn-primary">{{t "common.save"}}</button>
          <button type="button" onclick="closeModal()" class="btn-secondary">{{t "common.cancel"}}</button>
        </div>
      </form>
    </div>
        </div>
</div>
