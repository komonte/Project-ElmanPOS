<div class="fixed inset-0 z-50 flex items-center justify-center bg-black/40" onclick="if (event.target === this) closeModal()">
  <div class="bg-white rounded-xl shadow-xl max-w-md w-full mx-4 p-6 max-h-[90vh] overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="form-title">
    <div class="flex items-center justify-between mb-4">
      <h2 id="form-title" class="text-lg font-semibold text-gray-900">{{if .Brand.ID}}{{t "brand.edit"}}{{else}}{{t "brand.create"}}{{end}}</h2>
      <button type="button" onclick="closeModal()" aria-label="{{t "common.close"}}"
              class="text-gray-400 hover:text-gray-600 text-2xl leading-none">&times;</button>
    </div>
    {{if .Error}}
    <div role="alert" class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700">{{.Error}}</div>
    {{end}}
    <form hx-post="{{if .Brand.ID}}/brands/{{.Brand.ID}}/edit{{else}}/brands/new{{end}}"
          hx-target="#form-modal" hx-swap="innerHTML"
          class="space-y-4">
      <div>
        <label for="brand-name" class="block text-sm font-medium text-gray-700 mb-1">{{t "brand.name"}}</label>
        <input type="text" id="brand-name" name="name" autofocus value="{{if .Brand}}{{.Brand.Name}}{{end}}" required
               class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500">
      </div>
      <div class="flex justify-end gap-3 pt-2">
        <button type="button" onclick="closeModal()"
                class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">
          {{t "common.cancel"}}
        </button>
        <button type="submit"
                class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition-colors">
          {{t "common.save"}}
        </button>
      </div>
    </form>
  </div>
</div>