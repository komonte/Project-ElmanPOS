{{/* Alta o edición de un cliente (0025), en el panel lateral como los
     usuarios. Solo el nombre es obligatorio. */}}
{{$editing := and .Customer .Customer.ID}}
<div class="fixed inset-0 z-50 flex justify-end bg-ink/40" onclick="if (event.target === this) closeModal()">
  <div class="h-full w-full sm:max-w-lg bg-surface border-l-8 border-tag overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="form-title">
    <div class="flex items-start justify-between gap-4 px-6 pt-6 pb-4 border-b-2 border-line">
      <h2 id="form-title" class="font-display font-bold text-3xl leading-tight">{{if $editing}}{{t "customer.edit"}}{{else}}{{t "customer.create"}}{{end}}</h2>
      <button type="button" onclick="closeModal()" aria-label="{{t "common.close"}}"
              class="-mr-2 px-2 text-3xl leading-none text-muted hover:text-ink">&times;</button>
    </div>
    <div class="px-6 py-6">
      {{if .Error}}
      <div role="alert" class="mb-6 p-4 bg-danger-soft border-l-8 border-danger rounded-sm font-bold">{{.Error}}</div>
      {{end}}
      <form id="customer-form" hx-post="{{if $editing}}/customers/{{.Customer.ID}}/edit{{else}}/customers/new{{end}}"
            hx-target="#form-modal" hx-swap="innerHTML" class="space-y-5">
        <div>
          <label for="customer-name" class="field-label">{{t "common.name"}} <span class="font-normal text-muted">{{t "common.required"}}</span></label>
          <input type="text" id="customer-name" name="name" autofocus required minlength="2" maxlength="120" autocomplete="off"
                 aria-describedby="customer-name-hint" value="{{if .Customer}}{{.Customer.Name}}{{end}}" class="field">
          <span id="customer-name-hint" class="field-hint">{{t "customer.name_hint"}}</span>
        </div>
        <div>
          <label for="customer-phone" class="field-label">{{t "customer.phone"}}</label>
          <input type="tel" id="customer-phone" name="phone" maxlength="40" autocomplete="off"
                 value="{{if .Customer}}{{.Customer.Phone}}{{end}}" class="field max-w-60">
        </div>
        <div>
          <label for="customer-notes" class="field-label">{{t "customer.notes"}}</label>
          <textarea id="customer-notes" name="notes" maxlength="300" rows="3" class="field">{{if .Customer}}{{.Customer.Notes}}{{end}}</textarea>
        </div>
        <div class="flex flex-wrap gap-3 pt-4">
          <button type="submit" class="btn-primary">{{t "common.save"}}</button>
          <button type="button" onclick="closeModal()" class="btn-secondary">{{t "common.cancel"}}</button>
        </div>
      </form>
    </div>
  </div>
</div>
