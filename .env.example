# HTTP Server
PORT=8080
# Dónde escucha: vacío = toda la red; 127.0.0.1 = solo esta PC.
LISTEN_HOST=
# HTTPS (recomendado en la red del local: la comparten otras personas).
# Los dos juntos o ninguno. Se hacen con mkcert (ver el README). Sin ellos,
# HTTP (solo para desarrollar).
TLS_CERT_FILE=
TLS_KEY_FILE=

# Zona horaria en que la pantalla muestra las fechas (la DB guarda UTC).
# Si falta, America/Argentina/Buenos_Aires.
STORE_TIMEZONE=America/Argentina/Buenos_Aires

# On the store's PC set ELMAN_ENV=store: make then refuses the targets that
# delete the database or write test data into it (db-down, db-reset,
# db-migrate-down, db-seed, test, check). Empty on development machines.
ELMAN_ENV=

# Copy to .env and adjust. .env is gitignored — never commit real secrets. DB_HOST=localhost
# On the store's PC: a new database (not elman_u) and a long password of its
# own. elman_u_dev is the development password and everyone has seen it.
# Postgres only takes the password when the volume is created: to change it
# later, ALTER USER ... PASSWORD inside the database as well.
DB_NAME=elman_u
DB_USER=elman_u
DB_PASSWORD=elman_u_dev
DB_PORT=5432
DB_SSLMODE=disable
