{{/* El nombre va en negrita con la marca abajo en gris. Sin búsqueda se
     muestran solo los primeros productos: el aviso de arriba dice cuántos
     hay en total. Filas inactivas en gris. */}}
{{template "list-notice" .}}
<table class="min-w-full text-left">
  <thead class="border-b-2 border-line text-muted">
    <tr>
      <th scope="col" class="px-3 py-3 font-bold whitespace-nowrap ">{{t "product.sku"}}</th>
      <th scope="col" class="px-3 py-3 font-bold whitespace-nowrap ">{{t "product.name_col"}}</th>
      <th scope="col" class="px-3 py-3 font-bold whitespace-nowrap ">{{t "product.category"}}</th>
      <th scope="col" class="px-3 py-3 font-bold whitespace-nowrap ">{{t "product.sale_type"}}</th>
      <th scope="col" class="px-3 py-3 font-bold whitespace-nowrap text-right">{{t "product.price_col"}}</th>
      <th scope="col" class="px-3 py-3 font-bold whitespace-nowrap text-right">{{t "product.stock_col"}}</th>
      <th scope="col" class="px-3 py-3 font-bold whitespace-nowrap ">{{t "common.status"}}</th>
      <th scope="col" class="px-3 py-3 font-bold whitespace-nowrap text-right">{{t "common.actions"}}</th>
    </tr>
  </thead>
  <tbody class="divide-y divide-line">
    {{range .Products}}
    <tr class="hover:bg-paper {{if not .IsActive}}text-muted{{end}}">
      <td class="px-3 py-3 whitespace-nowrap tabular">{{.SKU}}</td>
      <td class="px-3 py-3 min-w-48">
        <span class="font-bold">{{.Name}}</span>
        {{if .BrandName}}<span class="block text-sm text-muted">{{.BrandName}}</span>{{end}}
      </td>
      <td class="px-3 py-3 whitespace-nowrap">{{.CategoryName}}</td>
      <td class="px-3 py-3 whitespace-nowrap">{{t (printf "product.sale_type_%s" .SaleType)}}</td>
      <td class="px-3 py-3 whitespace-nowrap text-right tabular">{{with .CurrentPrice}}{{money .}}{{else}}<span class="text-muted">—</span>{{end}}</td>
      {{/* Stock (todos los locales). En modo arranque, un producto que
           nunca se movió dice "Sin contar": 0 no quiere decir "no hay". */}}
      <td class="px-3 py-3 whitespace-nowrap text-right tabular" data-stock>{{if $.Stock}}{{with index $.Stock .ID}}
        {{- if .None}}<span class="text-muted" title="{{t "product.stock_none_hint"}}">—</span>
        {{- else if .NotCount}}<span class="text-muted italic" data-not-counted>{{t "product.stock_not_counted"}}</span>
        {{- else}}<span class="{{if not .OnHand.IsPositive}}text-danger font-bold{{end}}">{{qty .OnHand}}{{if .Weight}} kg{{end}}</span>{{end}}
        {{- if .Uncovered.IsPositive}}<span class="block text-sm font-bold text-danger" data-uncovered>{{printf (t "product.stock_uncovered") (qty .Uncovered)}}</span>{{end}}
      {{- end}}{{end}}</td>
      <td class="px-3 py-3 whitespace-nowrap">
        <span class="inline-flex items-center gap-2">
          <span aria-hidden="true" class="size-3 rounded-full {{if .IsActive}}bg-stock{{else}}border-2 border-muted{{end}}"></span>
          {{if .IsActive}}{{t "common.status_active"}}{{else}}{{t "common.status_inactive"}}{{end}}
        </span>
      </td>
      <td class="px-2 py-2">
        <div class="flex flex-wrap justify-end">
        <button hx-get="/products/{{.ID}}/edit" hx-target="#form-modal" hx-swap="innerHTML"
                class="px-2 py-1 whitespace-nowrap rounded-sm font-bold text-ink underline-offset-4 hover:underline">{{t "common.edit"}}</button>
        {{if .IsActive}}
        <button hx-include="[name='search']" hx-patch="/products/{{.ID}}/deactivate" hx-confirm="{{t "product.deactivate_confirm"}}" hx-target="#products-table" hx-swap="innerHTML"
                class="px-2 py-1 whitespace-nowrap rounded-sm font-bold text-muted underline-offset-4 hover:underline hover:text-ink">{{t "product.deactivate"}}</button>
        {{else}}
        <button hx-include="[name='search']" hx-patch="/products/{{.ID}}/reactivate" hx-target="#products-table" hx-swap="innerHTML"
                class="px-2 py-1 whitespace-nowrap rounded-sm font-bold text-stock underline-offset-4 hover:underline">{{t "product.activate"}}</button>
        {{end}}
        <button hx-include="[name='search']" hx-delete="/products/{{.ID}}" hx-confirm="{{t "product.delete_confirm"}}" hx-target="#products-table" hx-swap="innerHTML"
                class="px-2 py-1 whitespace-nowrap rounded-sm font-bold text-danger underline-offset-4 hover:underline">{{t "common.delete"}}</button>
        </div>
      </td>
    </tr>
    {{else}}
    <tr>
      <td colspan="8" class="px-4 py-12 text-center text-muted whitespace-normal">{{t "common.no_results"}}</td>
    </tr>
    {{end}}
  </tbody>
</table>
