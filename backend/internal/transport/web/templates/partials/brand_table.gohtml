{{/* Filas inactivas en gris: siguen en la lista para poder reactivarlas. */}}
<table class="min-w-full text-left">
  <thead class="border-b-2 border-line text-muted">
    <tr>
      <th scope="col" class="px-3 py-3 font-bold whitespace-nowrap ">{{t "common.id"}}</th>
      <th scope="col" class="px-3 py-3 font-bold whitespace-nowrap ">{{t "common.name"}}</th>
      <th scope="col" class="px-3 py-3 font-bold whitespace-nowrap ">{{t "common.created_at"}}</th>
      <th scope="col" class="px-3 py-3 font-bold whitespace-nowrap ">{{t "common.status"}}</th>
      <th scope="col" class="px-3 py-3 font-bold whitespace-nowrap text-right">{{t "common.actions"}}</th>
    </tr>
  </thead>
  <tbody class="divide-y divide-line">
    {{range .Brands}}
    <tr class="hover:bg-paper {{if not .IsActive}}text-muted{{end}}">
      <td class="px-3 py-3 text-muted whitespace-nowrap">{{.ID}}</td>
      <td class="px-3 py-3 font-bold min-w-48">{{.Name}}</td>
      <td class="px-3 py-3 text-muted whitespace-nowrap">{{formatTime .CreatedAt}}</td>
      <td class="px-3 py-3 whitespace-nowrap">
        <span class="inline-flex items-center gap-2">
          <span aria-hidden="true" class="size-3 rounded-full {{if .IsActive}}bg-stock{{else}}border-2 border-muted{{end}}"></span>
          {{if .IsActive}}{{t "brand.status_active"}}{{else}}{{t "brand.status_inactive"}}{{end}}
        </span>
      </td>
      <td class="px-2 py-2">
        <div class="flex flex-wrap justify-end">
        <button hx-get="/brands/{{.ID}}/edit" hx-target="#form-modal" hx-swap="innerHTML"
                class="px-2 py-1 whitespace-nowrap rounded-sm font-bold text-ink underline-offset-4 hover:underline">{{t "common.edit"}}</button>
        {{if .IsActive}}
        <button hx-include="[name='search']" hx-patch="/brands/{{.ID}}/deactivate" hx-confirm="{{t "brand.deactivate_confirm"}}" hx-target="#brands-table" hx-swap="innerHTML"
                class="px-2 py-1 whitespace-nowrap rounded-sm font-bold text-muted underline-offset-4 hover:underline hover:text-ink">{{t "brand.deactivate"}}</button>
        {{else}}
        <button hx-include="[name='search']" hx-patch="/brands/{{.ID}}/reactivate" hx-target="#brands-table" hx-swap="innerHTML"
                class="px-2 py-1 whitespace-nowrap rounded-sm font-bold text-stock underline-offset-4 hover:underline">{{t "brand.activate"}}</button>
        {{end}}
        <button hx-include="[name='search']" hx-delete="/brands/{{.ID}}" hx-confirm="{{t "brand.delete_confirm"}}" hx-target="#brands-table" hx-swap="innerHTML"
                class="px-2 py-1 whitespace-nowrap rounded-sm font-bold text-danger underline-offset-4 hover:underline">{{t "common.delete"}}</button>
        </div>
      </td>
    </tr>
    {{else}}
    <tr>
      <td colspan="5" class="px-4 py-12 text-center text-muted whitespace-normal">{{t "common.no_results"}}</td>
    </tr>
    {{end}}
  </tbody>
</table>
