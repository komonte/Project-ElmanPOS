{{/* Contraseña nueva de un usuario (F-13). Cierra todas sus sesiones: si
     es la propia, también esta, y se vuelve a entrar (el aviso lo dice antes
     de guardar). Al terminar con otro usuario, el panel dice que quedó. */}}
<div class="fixed inset-0 z-50 flex justify-end bg-ink/40" onclick="if (event.target === this) closeModal()">
  <div class="h-full w-full sm:max-w-lg bg-surface border-l-8 border-tag overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="form-title">
    <div class="flex items-start justify-between gap-4 px-6 pt-6 pb-4 border-b-2 border-line">
      <h2 id="form-title" class="font-display font-bold text-3xl leading-tight">{{t "user.password_title"}}</h2>
      <button type="button" onclick="closeModal()" aria-label="{{t "common.close"}}"
              class="-mr-2 px-2 text-3xl leading-none text-muted hover:text-ink">&times;</button>
    </div>
    <div class="px-6 py-6">
      <p class="mb-6 text-lg"><span class="font-bold">{{.User.Name}}</span> <span class="text-muted">({{.User.Username}})</span></p>
      {{if .Done}}
      <div id="password-done" role="status" class="mb-6 p-4 bg-paper border-l-8 border-stock rounded-sm font-bold">{{t "user.password_done"}}</div>
      <button type="button" onclick="closeModal()" class="btn-primary" autofocus>{{t "common.close"}}</button>
      {{else}}
      {{if .Error}}
      <div role="alert" class="mb-6 p-4 bg-danger-soft border-l-8 border-danger rounded-sm font-bold">{{.Error}}</div>
      {{end}}
      <p id="password-warning" class="mb-6 p-4 bg-paper border-l-8 border-tag rounded-sm">{{if .Self}}{{t "user.password_self_warning"}}{{else}}{{t "user.password_warning"}}{{end}}</p>
      <form id="password-form" hx-post="/users/{{.User.ID}}/password" hx-target="#form-modal" hx-swap="innerHTML" class="space-y-5">
        <div>
          <label for="password-new" class="field-label">{{t "user.new_password"}}</label>
          <input type="password" id="password-new" name="password" required autofocus minlength="{{.PasswordMinLen}}"
                 autocomplete="new-password" aria-describedby="password-new-hint" class="field">
          <span id="password-new-hint" class="field-hint">{{printf (t "user.password_hint") .PasswordMinLen}}</span>
        </div>
        <div>
          <label for="password-again" class="field-label">{{t "user.password_again"}}</label>
          <input type="password" id="password-again" name="password_again" required minlength="{{.PasswordMinLen}}"
                 autocomplete="new-password" class="field">
        </div>
        <div class="flex flex-wrap gap-3 pt-4">
          <button type="submit" class="btn-primary">{{t "user.password_save"}}</button>
          <button type="button" onclick="closeModal()" class="btn-secondary">{{t "common.cancel"}}</button>
        </div>
      </form>
      {{end}}
    </div>
  </div>
</div>
