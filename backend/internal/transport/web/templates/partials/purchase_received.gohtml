{{/* Resultado de una recepción guardada (reemplaza al formulario).

     Datos: .Purchase (con .Items), .Difference (total escrito menos la suma
     de los renglones), .HasDifference y .Products (cuántos productos
     distintos). Ningún precio cambia solo: se ponen en el detalle de la
     factura. */}}
<div id="purchase-panel" class="space-y-5">
  <div role="status" class="p-4 bg-surface border-l-8 border-tag rounded-sm">
    <p class="font-display font-bold text-2xl">{{t "purchase.received"}}</p>
    <p class="text-muted">{{printf (t "purchase.received_detail") .Purchase.ID (len .Purchase.Items)}}</p>
  </div>
  {{if .HasDifference}}
  <div role="alert" class="p-4 bg-danger-soft border-l-8 border-danger rounded-sm font-bold">
    {{printf (t "purchase.difference_warning") (money .Difference)}}
  </div>
  {{end}}

  {{/* Los precios se ponen por factura: el detalle muestra qué productos
       están sin cotizar y, al admin, el formulario para cotizarlos. */}}
  <div class="p-4 bg-paper border-l-8 border-tag rounded-sm">
    <p class="font-bold">{{printf (t "purchase.price_it") .Products}}</p>
    <p class="text-muted">{{t "purchase.price_it_hint"}}</p>
  </div>
  <div class="flex flex-wrap gap-3">
  <a id="purchase-price-it" href="/purchases/{{.Purchase.ID}}" class="btn-primary">{{t "purchase.see_invoice"}}</a>
  <a href="/purchases" class="btn-secondary">{{t "purchase.receive_another"}}</a>
  </div>
</div>
