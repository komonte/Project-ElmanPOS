{{/* Las últimas salidas del local (la más nueva primero). Al anotar una, la
     respuesta la manda fuera de lugar (.OOB). Datos: .Adjustments y .OOB. */}}
<section id="adjustment-recent" {{if .OOB}}hx-swap-oob="true"{{end}} aria-labelledby="adjustment-recent-title" class="space-y-3">
  <h2 id="adjustment-recent-title" class="font-display font-bold text-2xl">{{t "adjustment.recent"}}</h2>
  {{if .Adjustments}}
  <div class="overflow-x-auto border-2 border-line rounded-md bg-surface">
    <table class="min-w-full text-left">
      <thead class="border-b-2 border-line text-muted">
        <tr>
          <th scope="col" class="px-3 py-3 font-bold">{{t "adjustment.when"}}</th>
          <th scope="col" class="px-3 py-3 font-bold">{{t "picker.product"}}</th>
          <th scope="col" class="px-3 py-3 font-bold">{{t "adjustment.reason"}}</th>
          <th scope="col" class="px-3 py-3 font-bold text-right">{{t "count.quantity"}}</th>
          <th scope="col" class="px-3 py-3 font-bold">{{t "adjustment.notes"}}</th>
          <th scope="col" class="px-3 py-3 font-bold">{{t "adjustment.by"}}</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        {{range .Adjustments}}
        <tr>
          <td class="px-3 py-3 whitespace-nowrap tabular">{{formatTime .CreatedAt}}</td>
          <td class="px-3 py-3 font-bold">{{.ProductName}}</td>
          <td class="px-3 py-3">{{t (printf "adjustment.reason_%s" .Reason)}}</td>
          <td class="px-3 py-3 text-right tabular">{{qty .Quantity}}</td>
          <td class="px-3 py-3 text-muted">{{.Notes}}</td>
          <td class="px-3 py-3 whitespace-nowrap">{{who .CreatedByName}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  {{else}}
  <p class="text-muted">{{t "adjustment.none"}}</p>
  {{end}}
</section>
