{{- /* Resultados del buscador de producto de un renglón de compra o conteo
     (PickerProductOptions). Elegir uno llama a pickerPick (picker_script).
     Sin resultados, ofrece dar de alta lo escrito (pickerQuickProduct) y, si
     es un código (.IsCode), agregarlo a un producto existente
     (pickerAssignCode). Sin espacios sueltos: si no hay nada, la lista queda
     vacía y :empty la oculta. */ -}}
{{- range .Products}}
<li role="option">
  <button type="button" data-id="{{.ID}}" data-name="{{.Name}}" data-batches="{{.ControlsBatches}}"
          data-shelf-life="{{with .ShelfLifeDays}}{{.}}{{end}}"
          onclick="pickerPick(this)"
          class="block w-full text-left px-3 py-2 hover:bg-paper focus:bg-paper">
    {{.Name}} <span class="text-sm text-muted">· {{.SKU}}{{if .ControlsBatches}} · {{t "picker.controls_batches"}}{{end}}</span>
  </button>
</li>
{{- end}}
{{- if and .Query (not .Products)}}
<li class="px-3 py-2 text-muted">{{t "picker.product_not_found"}}</li>
<li>
  <button type="button" data-quick-product data-q="{{.Query}}" onclick="pickerQuickProduct(this)"
          class="block w-full text-left px-3 py-2 font-bold hover:bg-paper focus:bg-paper">{{printf (t "picker.quick_offer") .Query}}</button>
</li>
{{- if .IsCode}}
<li>
  <button type="button" data-q="{{.Query}}" onclick="pickerAssignCode(this)"
          class="block w-full text-left px-3 py-2 font-bold hover:bg-paper focus:bg-paper">{{t "picker.assign_offer"}}</button>
</li>
{{- end}}
{{- end -}}
