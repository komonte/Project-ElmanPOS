{{/* Menú lateral oscuro (tinta). Los títulos de grupo (.nav-group, en
     input.css) son amarillos, chicos y en mayúsculas, con una línea arriba:
     no se confunden con los links, que son blancos. En celular pasa a ser una barra arriba con
     los links en una fila que se desliza de costado. Los grupos (Catálogo,
     Inventario, Caja, Reportes y Administración) ordenan el menú a medida que crece. "Vender" va
     primero y destacado. */}}
<nav class="print:hidden bg-ink text-white md:w-60 md:shrink-0 md:min-h-screen md:sticky md:top-0 md:self-start md:h-screen flex flex-col">
  <div class="flex items-center justify-between gap-4 px-4 pt-4 pb-3 md:px-5 md:pt-6 md:pb-6">
    <a href="/" class="font-display font-bold text-3xl leading-none tracking-wide">Elman<span class="text-tag">POS</span></a>
    <div class="md:hidden">{{template "lang-select" .}}</div>
  </div>


  <div id="nav-links" class="flex md:flex-col gap-1 overflow-x-auto px-2 pb-2 md:px-3 md:pb-0 md:flex-1">
      {{/* Vender es lo que más se usa: va primero y se ve distinto, como
           un cartel de góndola. */}}
      {{if can .Can "sell"}}
      <a href="/pos" {{if eq .Section "pos"}}aria-current="page"{{end}}
         class="shrink-0 flex items-center justify-center gap-2 px-4 py-2 md:py-3 md:mb-3 rounded-md whitespace-nowrap bg-tag text-ink font-display font-bold uppercase tracking-wide text-xl md:text-2xl border-b-4 {{if eq .Section "pos"}}border-white{{else}}border-tag-deep hover:bg-tag-deep{{end}}">{{t "nav.pos"}}</a>
      {{end}}
      <a href="/" {{if eq .Section "dashboard"}}aria-current="page"{{end}}
         class="shrink-0 flex items-center gap-2 px-3 py-2 rounded-sm whitespace-nowrap border-l-4 {{if eq .Section "dashboard"}}border-tag bg-white/10 text-white font-bold{{else}}border-transparent text-white/75 hover:text-white hover:bg-white/5{{end}}">{{t "nav.dashboard"}}</a>
      {{if can .Can "catalog"}}
    <p class="nav-group hidden md:block">{{t "nav.group_catalog"}}</p>
      <a href="/products" {{if eq .Section "products"}}aria-current="page"{{end}}
         class="shrink-0 flex items-center gap-2 px-3 py-2 rounded-sm whitespace-nowrap border-l-4 {{if eq .Section "products"}}border-tag bg-white/10 text-white font-bold{{else}}border-transparent text-white/75 hover:text-white hover:bg-white/5{{end}}">{{t "nav.products"}}</a>
      <a href="/categories" {{if eq .Section "categories"}}aria-current="page"{{end}}
         class="shrink-0 flex items-center gap-2 px-3 py-2 rounded-sm whitespace-nowrap border-l-4 {{if eq .Section "categories"}}border-tag bg-white/10 text-white font-bold{{else}}border-transparent text-white/75 hover:text-white hover:bg-white/5{{end}}">{{t "nav.categories"}}</a>
      <a href="/brands" {{if eq .Section "brands"}}aria-current="page"{{end}}
         class="shrink-0 flex items-center gap-2 px-3 py-2 rounded-sm whitespace-nowrap border-l-4 {{if eq .Section "brands"}}border-tag bg-white/10 text-white font-bold{{else}}border-transparent text-white/75 hover:text-white hover:bg-white/5{{end}}">{{t "nav.brands"}}</a>
      {{end}}
      {{if can .Can "prices"}}
      <a href="/taxes" {{if eq .Section "taxes"}}aria-current="page"{{end}}
         class="shrink-0 flex items-center gap-2 px-3 py-2 rounded-sm whitespace-nowrap border-l-4 {{if eq .Section "taxes"}}border-tag bg-white/10 text-white font-bold{{else}}border-transparent text-white/75 hover:text-white hover:bg-white/5{{end}}">{{t "nav.taxes"}}</a>
      {{end}}
      {{if can .Can "catalog"}}
      <a href="/suppliers" {{if eq .Section "suppliers"}}aria-current="page"{{end}}
         class="shrink-0 flex items-center gap-2 px-3 py-2 rounded-sm whitespace-nowrap border-l-4 {{if eq .Section "suppliers"}}border-tag bg-white/10 text-white font-bold{{else}}border-transparent text-white/75 hover:text-white hover:bg-white/5{{end}}">{{t "nav.suppliers"}}</a>
      {{end}}
      {{if can .Can "stock"}}
    <p class="nav-group hidden md:block">{{t "nav.group_inventory"}}</p>
      <a href="/purchases" {{if eq .Section "purchases"}}aria-current="page"{{end}}
         class="shrink-0 flex items-center gap-2 px-3 py-2 rounded-sm whitespace-nowrap border-l-4 {{if eq .Section "purchases"}}border-tag bg-white/10 text-white font-bold{{else}}border-transparent text-white/75 hover:text-white hover:bg-white/5{{end}}">{{t "nav.purchases"}}</a>
      <a href="/purchases/history" {{if eq .Section "purchase_history"}}aria-current="page"{{end}}
         class="shrink-0 flex items-center gap-2 px-3 py-2 rounded-sm whitespace-nowrap border-l-4 {{if eq .Section "purchase_history"}}border-tag bg-white/10 text-white font-bold{{else}}border-transparent text-white/75 hover:text-white hover:bg-white/5{{end}}">{{t "nav.purchase_history"}}</a>
      <a href="/counts" {{if eq .Section "counts"}}aria-current="page"{{end}}
         class="shrink-0 flex items-center gap-2 px-3 py-2 rounded-sm whitespace-nowrap border-l-4 {{if eq .Section "counts"}}border-tag bg-white/10 text-white font-bold{{else}}border-transparent text-white/75 hover:text-white hover:bg-white/5{{end}}">{{t "nav.counts"}}</a>
      <a href="/adjustments" {{if eq .Section "adjustments"}}aria-current="page"{{end}}
         class="shrink-0 flex items-center gap-2 px-3 py-2 rounded-sm whitespace-nowrap border-l-4 {{if eq .Section "adjustments"}}border-tag bg-white/10 text-white font-bold{{else}}border-transparent text-white/75 hover:text-white hover:bg-white/5{{end}}">{{t "nav.adjustments"}}</a>
      {{end}}
      {{if can .Can "cash"}}
    <p class="nav-group hidden md:block">{{t "nav.group_cash"}}</p>
      <a href="/cash" {{if eq .Section "cash"}}aria-current="page"{{end}}
         class="shrink-0 flex items-center gap-2 px-3 py-2 rounded-sm whitespace-nowrap border-l-4 {{if eq .Section "cash"}}border-tag bg-white/10 text-white font-bold{{else}}border-transparent text-white/75 hover:text-white hover:bg-white/5{{end}}">{{t "nav.cash"}}</a>
      {{end}}
      {{if or (can .Can "reports") (can .Can "stock") (can .Can "catalog")}}
    <p class="nav-group hidden md:block">{{t "nav.group_reports"}}</p>
      {{end}}
      {{if can .Can "reports"}}
      <a href="/reports/sales" {{if eq .Section "reports_sales"}}aria-current="page"{{end}}
         class="shrink-0 flex items-center gap-2 px-3 py-2 rounded-sm whitespace-nowrap border-l-4 {{if eq .Section "reports_sales"}}border-tag bg-white/10 text-white font-bold{{else}}border-transparent text-white/75 hover:text-white hover:bg-white/5{{end}}">{{t "nav.report_sales"}}</a>
      <a href="/reports/cash" {{if eq .Section "reports_cash"}}aria-current="page"{{end}}
         class="shrink-0 flex items-center gap-2 px-3 py-2 rounded-sm whitespace-nowrap border-l-4 {{if eq .Section "reports_cash"}}border-tag bg-white/10 text-white font-bold{{else}}border-transparent text-white/75 hover:text-white hover:bg-white/5{{end}}">{{t "nav.report_cash"}}</a>
      {{end}}
      {{if can .Can "stock"}}
      <a href="/reports/restock" {{if eq .Section "reports_restock"}}aria-current="page"{{end}}
         class="shrink-0 flex items-center gap-2 px-3 py-2 rounded-sm whitespace-nowrap border-l-4 {{if eq .Section "reports_restock"}}border-tag bg-white/10 text-white font-bold{{else}}border-transparent text-white/75 hover:text-white hover:bg-white/5{{end}}">{{t "nav.report_restock"}}</a>
      <a href="/reports/expiring" {{if eq .Section "reports_expiring"}}aria-current="page"{{end}}
         class="shrink-0 flex items-center gap-2 px-3 py-2 rounded-sm whitespace-nowrap border-l-4 {{if eq .Section "reports_expiring"}}border-tag bg-white/10 text-white font-bold{{else}}border-transparent text-white/75 hover:text-white hover:bg-white/5{{end}}">{{t "nav.report_expiring"}}</a>
      <a href="/reports/unstocked" {{if eq .Section "reports_unstocked"}}aria-current="page"{{end}}
         class="shrink-0 flex items-center gap-2 px-3 py-2 rounded-sm whitespace-nowrap border-l-4 {{if eq .Section "reports_unstocked"}}border-tag bg-white/10 text-white font-bold{{else}}border-transparent text-white/75 hover:text-white hover:bg-white/5{{end}}">{{t "nav.report_unstocked"}}</a>
      {{end}}
      {{if can .Can "catalog"}}
      <a href="/reports/unregistered" {{if eq .Section "reports_unregistered"}}aria-current="page"{{end}}
         class="shrink-0 flex items-center gap-2 px-3 py-2 rounded-sm whitespace-nowrap border-l-4 {{if eq .Section "reports_unregistered"}}border-tag bg-white/10 text-white font-bold{{else}}border-transparent text-white/75 hover:text-white hover:bg-white/5{{end}}">{{t "nav.report_unregistered"}}</a>
      {{end}}
      {{if or (can .Can "users") (can .Can "settings")}}
    <p class="nav-group hidden md:block">{{t "nav.group_admin"}}</p>
      {{end}}
      {{if can .Can "users"}}
      <a href="/users" {{if eq .Section "users"}}aria-current="page"{{end}}
         class="shrink-0 flex items-center gap-2 px-3 py-2 rounded-sm whitespace-nowrap border-l-4 {{if eq .Section "users"}}border-tag bg-white/10 text-white font-bold{{else}}border-transparent text-white/75 hover:text-white hover:bg-white/5{{end}}">{{t "nav.users"}}</a>
      {{end}}
      {{if can .Can "settings"}}
      <a href="/settings" {{if eq .Section "settings"}}aria-current="page"{{end}}
         class="shrink-0 flex items-center gap-2 px-3 py-2 rounded-sm whitespace-nowrap border-l-4 {{if eq .Section "settings"}}border-tag bg-white/10 text-white font-bold{{else}}border-transparent text-white/75 hover:text-white hover:bg-white/5{{end}}">{{t "nav.settings"}}</a>
      {{end}}
  </div>

  {{/* Quién entró, con qué rol, y "Salir" (F-13). Abajo de los links y
       fuera de su barra de desplazamiento: queda siempre en el mismo lugar
       y siempre se ve con qué usuario se está trabajando. El rol va en una
       etiqueta de color (cada rol el suyo). */}}
  {{with .CurrentUser}}
  <div id="nav-user" class="mx-2 mb-2 md:mx-3 md:my-3 px-3 py-2 rounded-md bg-white/10 border border-white/15">
    <p class="text-xs text-white/60">{{t "nav.signed_in_as"}}</p>
    <p class="font-bold truncate">{{.Name}}</p>
    <div class="mt-1 flex flex-wrap items-center justify-between gap-2">
      <span id="nav-role" data-role="{{.Role}}"
            class="px-2 py-0.5 rounded-sm text-sm font-bold {{if eq .Role "ADMIN"}}bg-danger text-white{{else if eq .Role "CASHIER"}}bg-stock text-white{{else}}bg-sky-700 text-white{{end}}">{{t (printf "role.%s" .Role)}}</span>
      <form method="post" action="/logout" class="shrink-0">
        <button type="submit" id="logout" class="px-3 py-1 rounded-md border-2 border-white/30 text-white hover:border-white">{{t "nav.logout"}}</button>
      </form>
    </div>
  </div>
  {{end}}
  <div class="hidden md:block px-5 py-5 border-t border-white/15">{{template "lang-select" .}}</div>
  {{/* Los links tienen su propia barra de desplazamiento (en celular, de
       costado). Cada link carga una página nueva, y sin esto el menú vuelve
       al principio: el link que se tocó queda fuera de la vista. Se guarda
       dónde estaba al salir y se recupera al entrar; y si aun así el link
       de la página actual no se ve, se lo trae a la vista. Va al final del
       menú (con todo el menú ya armado, si no la altura no es la final) y
       antes del contenido de la página: corre antes de dibujarse, sin salto. */}}
  <script>
    (function () {
      var box = document.getElementById('nav-links');
      var key = 'elmanpos-nav-scroll';
      try {
        var saved = JSON.parse(sessionStorage.getItem(key) || 'null');
        if (saved) {
          box.scrollTop = saved.top;
          box.scrollLeft = saved.left;
        }
      } catch (e) { /* sin sessionStorage: arranca arriba */ }
      var active = box.querySelector('[aria-current="page"]');
      if (active) {
        var a = active.getBoundingClientRect(), b = box.getBoundingClientRect();
        if (a.top < b.top || a.bottom > b.bottom || a.left < b.left || a.right > b.right) {
          box.scrollTop += a.top < b.top ? a.top - b.top : Math.max(a.bottom - b.bottom, 0);
          box.scrollLeft += a.left < b.left ? a.left - b.left : Math.max(a.right - b.right, 0);
        }
      }
      window.addEventListener('pagehide', function () {
        try {
          sessionStorage.setItem(key, JSON.stringify({ top: box.scrollTop, left: box.scrollLeft }));
        } catch (e) { /* nada que guardar */ }
      });
    })();
  </script>
</nav>

{{define "lang-select"}}
{{/* Aparece dos veces (barra de celular y pie del menú); por eso no usa id
     y se nombra con aria-label. */}}
<div class="flex items-center gap-2">
  <select name="lang" aria-label="{{t "language.select"}}"
          hx-post="/settings/language" hx-trigger="change" hx-swap="none"
          class="bg-ink text-white border-2 border-white/30 rounded-md px-2 py-1 hover:border-white">
    <option value="es" {{if eq .Lang "es"}}selected{{end}}>{{t "language.es"}}</option>
    <option value="en" {{if eq .Lang "en"}}selected{{end}}>{{t "language.en"}}</option>
  </select>
</div>
{{end}}
