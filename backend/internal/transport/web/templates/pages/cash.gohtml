{{define "content"}}
{{/* Caja (F-11). Datos: .State (sessions.State: .Register y .Session, nil
     si no hay), .Amount (lo escrito si abrir falló) y .Error. */}}
<header class="mb-8">
  <h1 class="shelf-title">{{t "cash.title"}}</h1>
  <p class="mt-2 text-muted max-w-2xl">{{t "cash.hint"}}</p>
</header>

{{if .Error}}
<div role="alert" class="mb-6 p-4 bg-danger-soft border-l-8 border-danger rounded-sm font-bold">{{.Error}}</div>
{{end}}

{{with .State}}
{{if not .Register}}
<section class="p-6 border-2 border-line rounded-md bg-surface max-w-2xl space-y-4">
  <h2 class="font-display font-bold text-2xl">{{t "cash.no_register_title"}}</h2>
  <p class="text-muted">{{t "cash.no_register_hint"}}</p>
  <form method="post" action="/cash/register">
    <button type="submit" class="btn-primary">{{t "cash.create_register"}}</button>
  </form>
</section>
{{else if .Session}}
<section id="cash-open" class="p-6 border-2 border-line border-l-8 border-l-tag rounded-md bg-surface max-w-2xl space-y-2">
  <h2 class="font-display font-bold text-2xl">{{printf (t "cash.open_title") .Register.Name}}</h2>
  <p>{{printf (t "cash.open_since") (formatTime .Session.OpenedAt)}}</p>
  <p>{{t "cash.opening_amount"}}: <span class="font-bold tabular">{{money .Session.OpeningAmount}}</span></p>
</section>
{{else}}
<section class="p-6 border-2 border-line rounded-md bg-surface max-w-2xl space-y-4">
  <h2 class="font-display font-bold text-2xl">{{printf (t "cash.closed_title") .Register.Name}}</h2>
  <form id="cash-open-form" method="post" action="/cash/open" class="space-y-3">
    <label class="field-label">{{t "cash.opening_amount"}}
      <input type="text" name="opening_amount" inputmode="decimal" autocomplete="off" required
             value="{{$.Amount}}" aria-describedby="cash-opening-hint" autofocus class="field tabular max-w-xs">
    </label>
    <p id="cash-opening-hint" class="field-hint">{{t "cash.opening_hint"}}</p>
    <button type="submit" class="btn-primary">{{t "cash.open"}}</button>
  </form>
</section>
{{end}}
{{end}}
{{end}}
