{{define "content"}}
<header class="mb-8">
  <h1 class="shelf-title">{{t "nav.dashboard"}}</h1>
  <p class="mt-4 text-lg text-muted">{{t "app.tagline"}}</p>
</header>

<section aria-labelledby="catalog-heading" class="max-w-2xl">
  <h2 id="catalog-heading" class="font-display font-bold text-3xl leading-none">{{t "nav.group_catalog"}}</h2>
  <p class="mt-1 mb-3 text-muted">{{t "dashboard.active_counts"}}</p>
  <ul class="bg-surface border-2 border-line rounded-md divide-y-2 divide-line">
    {{template "dashboard-row" (dict "Href" "/brands" "Label" (t "nav.brands") "Count" .BrandCount)}}
    {{template "dashboard-row" (dict "Href" "/taxes" "Label" (t "nav.taxes") "Count" .TaxCount)}}
    {{template "dashboard-row" (dict "Href" "/suppliers" "Label" (t "nav.suppliers") "Count" .SupplierCount)}}
  </ul>
</section>
{{end}}

{{define "dashboard-row"}}
<li>
  <a href="{{.Href}}" class="flex items-center justify-between gap-4 px-5 py-4 hover:bg-paper">
    <span class="text-lg font-bold">{{.Label}}</span>
    <span class="font-display font-bold text-4xl leading-none tabular">{{.Count}}</span>
  </a>
</li>
{{end}}
