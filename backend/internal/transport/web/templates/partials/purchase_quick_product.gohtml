{{/* Alta rápida de producto desde un renglón de compra (panel lateral, como
     el de productos). Solo lo necesario para recibir y ponerle precio; lo
     demás se completa después en la ficha. El SKU lo genera la base.

     Va en #form-modal, fuera del <form> de la compra (no puede haber un form
     dentro de otro). Guardar bien responde vacío (cierra el panel) y el
     evento purchaseProductCreated; con error vuelve este mismo panel.

     El foco va al primer dato que falta: si vino el código (se escaneó), al
     nombre; si vino el nombre, a la categoría.

     Datos: .Product (quickProduct: lo escrito), .Categories (activas) y
     .Error. */}}
<div class="fixed inset-0 z-50 flex justify-end bg-ink/40" onclick="if (event.target === this) closeModal()">
  <div class="h-full w-full sm:max-w-lg bg-surface border-l-8 border-tag overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="form-title">
    <div class="flex items-start justify-between gap-4 px-6 pt-6 pb-4 border-b-2 border-line">
      <div>
        <h2 id="form-title" class="font-display font-bold text-3xl leading-tight">{{t "purchase.quick_title"}}</h2>
        <p class="mt-1 text-sm text-muted">{{t "purchase.quick_hint"}}</p>
      </div>
      <button type="button" onclick="closeModal()" aria-label="{{t "common.close"}}"
              class="-mr-2 px-2 text-3xl leading-none text-muted hover:text-ink">&times;</button>
    </div>
    <div class="px-6 py-6">
      {{if .Error}}
      <div role="alert" class="mb-6 p-4 bg-danger-soft border-l-8 border-danger rounded-sm font-bold">{{.Error}}</div>
      {{end}}
      {{with .Product}}
      <form hx-post="/purchases/quick-product" hx-target="#form-modal" hx-swap="innerHTML" class="space-y-5">
        <div>
          <label for="quick-name" class="field-label">{{t "product.name"}} <span class="font-normal text-muted">{{t "common.required"}}</span></label>
          <input type="text" id="quick-name" name="name" required autocomplete="off" value="{{.Name}}"
                 {{if not .Name}}autofocus{{end}} class="field">
        </div>
        <div>
          <label for="quick-category" class="field-label">{{t "product.category"}} <span class="font-normal text-muted">{{t "common.required"}}</span></label>
          <select id="quick-category" name="category_id" required {{if .Name}}autofocus{{end}} class="field">
            <option value="" disabled {{if not .CategoryID}}selected{{end}}>{{t "product.category_choose"}}</option>
            {{range $.Categories}}
            <option value="{{.ID}}" {{if .Selected}}selected{{end}}>{{.Label}}</option>
            {{end}}
          </select>
        </div>
        <div>
          <label for="quick-barcode" class="field-label">{{t "product.barcode"}}</label>
          <input type="text" id="quick-barcode" name="barcode" inputmode="numeric" autocomplete="off" value="{{.Barcode}}"
                 onkeydown="if (event.key === 'Enter') event.preventDefault()" class="field tabular">
        </div>
        <fieldset>
          <legend class="field-label">{{t "purchase.quick_sold_by"}}</legend>
          <div class="flex flex-wrap gap-6">
            <label class="inline-flex items-center gap-2">
              <input type="radio" name="sold_by" value="unit" {{if not .ByWeight}}checked{{end}} class="size-5 accent-ink"> {{t "purchase.quick_by_unit"}}
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="radio" name="sold_by" value="kg" {{if .ByWeight}}checked{{end}} class="size-5 accent-ink"> {{t "purchase.quick_by_kg"}}
            </label>
          </div>
        </fieldset>
        <label class="flex items-start gap-3">
          <input type="checkbox" name="controls_batches" value="1" {{if .ControlsBatches}}checked{{end}} class="mt-1 size-5 accent-ink">
          <span>
            <span class="font-bold">{{t "product.controls_batches"}}</span>
            <span class="block text-sm text-muted">{{t "product.controls_batches_hint"}}</span>
          </span>
        </label>
        <div>
          <label for="quick-margin" class="field-label">{{t "product.margin_percent"}}</label>
          <input type="text" id="quick-margin" name="margin_percent" inputmode="decimal" autocomplete="off"
                 aria-describedby="quick-margin-hint" value="{{.Margin}}" class="field max-w-40 tabular">
          <span id="quick-margin-hint" class="field-hint">{{t "product.margin_hint"}}</span>
        </div>
        <div class="flex flex-wrap gap-3 pt-4">
          <button type="submit" class="btn-primary">{{t "purchase.quick_save"}}</button>
          <button type="button" onclick="closeModal()" class="btn-secondary">{{t "common.cancel"}}</button>
        </div>
      </form>
      {{end}}
    </div>
  </div>
</div>
