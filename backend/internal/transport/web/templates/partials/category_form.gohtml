{{/* Panel lateral, igual que el de proveedores. Los <select> muestran el
     camino completo ("Almacen › Varios"), porque un mismo nombre puede estar
     en dos lugares del árbol. */}}
<div class="fixed inset-0 z-50 flex justify-end bg-ink/40" onclick="if (event.target === this) closeModal()">
  <div class="h-full w-full sm:max-w-lg bg-surface border-l-8 border-tag overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="form-title">
    <div class="flex items-start justify-between gap-4 px-6 pt-6 pb-4 border-b-2 border-line">
      <h2 id="form-title" class="font-display font-bold text-3xl leading-tight">{{if .Category.ID}}{{t "category.edit"}}{{else}}{{t "category.create"}}{{end}}</h2>
      <button type="button" onclick="closeModal()" aria-label="{{t "common.close"}}"
              class="-mr-2 px-2 text-3xl leading-none text-muted hover:text-ink">&times;</button>
    </div>
    <div class="px-6 py-6">
      {{if .Error}}
      <div role="alert" class="mb-6 p-4 bg-danger-soft border-l-8 border-danger rounded-sm font-bold">{{.Error}}</div>
      {{end}}
      <form hx-post="{{if .Category.ID}}/categories/{{.Category.ID}}/edit{{else}}/categories/new{{end}}"
            hx-target="#form-modal" hx-swap="innerHTML"
            class="space-y-5">
        <div>
          <label for="category-name" class="field-label">{{t "category.name"}} <span class="font-normal text-muted">{{t "common.required"}}</span></label>
          <input type="text" id="category-name" name="name" autofocus required maxlength="120"
                 value="{{.Category.Name}}" class="field">
        </div>
        <div>
          <label for="category-parent" class="field-label">{{t "category.parent"}}</label>
          {{/* Al crear, elegir un padre copia su IVA al select de abajo
               (data-tax-id). Solo si ese IVA está en la lista: si el del
               padre está inactivo, el select queda como estaba. Al editar no
               se copia, para no cambiar el IVA sin querer al mover la categoría. */}}
          <select id="category-parent" name="parent_id" aria-describedby="category-parent-hint" class="field"
                  {{if not .Category.ID}}onchange="const t = this.selectedOptions[0].dataset.taxId; const s = this.form.elements.tax_id; if (t && [...s.options].some(o => o.value === t)) s.value = t;"{{end}}>
            <option value="">{{t "category.parent_none"}}</option>
            {{range .Parents}}
            <option value="{{.ID}}" data-tax-id="{{.TaxID}}" {{if .Selected}}selected{{end}}>{{.Label}}{{if .Inactive}} {{t "category.inactive_suffix"}}{{end}}</option>
            {{end}}
          </select>
          <span id="category-parent-hint" class="field-hint">{{t "category.parent_hint"}}</span>
        </div>
        <div>
          <label for="category-tax" class="field-label">{{t "category.tax"}} <span class="font-normal text-muted">{{t "common.required"}}</span></label>
          <select id="category-tax" name="tax_id" required aria-describedby="category-tax-hint" class="field max-w-60">
            <option value="" disabled {{if not .Category.TaxID}}selected{{end}}>{{t "category.tax_choose"}}</option>
            {{range .Taxes}}
            <option value="{{.ID}}" {{if .Selected}}selected{{end}}>{{.Label}}{{if .Inactive}} {{t "category.inactive_suffix"}}{{end}}</option>
            {{end}}
          </select>
          <span id="category-tax-hint" class="field-hint">{{if .Category.ID}}{{t "category.tax_hint"}}{{else}}{{t "category.tax_hint_new"}}{{end}}</span>
        </div>
        <div class="flex flex-wrap gap-3 pt-4">
          <button type="submit" class="btn-primary">{{t "common.save"}}</button>
          <button type="button" onclick="closeModal()" class="btn-secondary">{{t "common.cancel"}}</button>
        </div>
      </form>
    </div>
  </div>
</div>
