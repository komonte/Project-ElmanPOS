<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{t "app.title"}}{{if .TitleKey}} - {{t .TitleKey}}{{end}}</title>
  <link rel="preload" href="/static/fonts/atkinson-hyperlegible-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/static/fonts/barlow-condensed-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/static/css/output.css">
  <script src="/static/js/htmx.min.js" defer></script>
</head>
<body class="min-h-screen md:flex">
  {{/* El login no tiene menú: sin sesión no hay a dónde ir. */}}
  {{if not .HideNav}}{{template "nav.gohtml" .}}{{end}}

  <main class="flex-1 min-w-0 px-4 py-6 sm:px-8 md:py-10">
    <div class="max-w-6xl">
      {{template "content" .}}
    </div>
  </main>

  {{/* Aviso para errores de acciones htmx (borrar, desactivar...). htmx no
       dibuja las respuestas 4xx/5xx, así que sin esto el botón parecería
       no hacer nada. El texto lo manda el servidor, ya traducido. */}}
  <div id="toast" role="alert" hidden
       data-network-error="{{t "error.network"}}"
       class="fixed bottom-4 right-4 left-4 sm:left-auto z-50 sm:max-w-md p-4 pr-12 bg-danger-soft text-ink border-l-8 border-danger rounded-md shadow-[0_6px_24px_rgb(30_42_68/0.25)]">
    <span id="toast-text" class="font-bold"></span>
    <button type="button" aria-label="{{t "common.close"}}" onclick="this.parentElement.hidden = true"
            class="absolute top-2 right-3 text-2xl leading-none text-danger hover:text-ink">&times;</button>
  </div>
  <script>
    // Los formularios se abren en #form-modal; vaciarlo lo cierra. El cursor
    // vuelve a donde se abrió el panel, si la pantalla lo marcó con
    // data-modal-return (compras y conteos: el buscador del renglón), o al buscador de
    // la pantalla (si tiene): se sigue buscando o escaneando sin tocar el mouse.
    function closeModal() {
      document.getElementById('form-modal').innerHTML = '';
      var back = document.querySelector('[data-modal-return]');
      if (back) {
        back.removeAttribute('data-modal-return');
        back.focus();
        return;
      }
      var search = document.getElementById('search');
      if (search) search.focus();
    }
    // Alta de producto: abre o cierra el subformulario de categoría nueva.
    // Abierto, el select de categoría se deshabilita (no se manda ni se
    // exige) y los campos de la nueva se habilitan; cerrado, al revés. Al
    // abrirlo, si ya había una categoría elegida, se propone como padre.
    function toggleNewCategory(form, open) {
      var box = document.getElementById('product-category-new');
      box.hidden = !open;
      box.querySelectorAll('input, select').forEach(function (el) { el.disabled = !open; });
      document.getElementById('product-category-new-open').hidden = open;
      var current = form.elements.category_id;
      current.disabled = open;
      if (!open) {
        current.focus();
        return;
      }
      var parent = form.elements.new_category_parent_id;
      if (current.value && !parent.value) {
        parent.value = current.value;
        parent.dispatchEvent(new Event('change'));
      }
      form.elements.new_category_name.focus();
    }
    document.addEventListener('keydown', function (e) {
      var modal = document.getElementById('form-modal');
      if (e.key === 'Escape' && modal && modal.firstElementChild) {
        closeModal();
      }
    });

    (function () {
      var toast = document.getElementById('toast');
      var timer;
      function show(msg) {
        document.getElementById('toast-text').textContent = msg;
        toast.hidden = false;
        clearTimeout(timer);
        timer = setTimeout(function () { toast.hidden = true; }, 8000);
      }
      document.addEventListener('htmx:responseError', function (e) {
        show(e.detail.xhr.responseText.trim() || e.detail.xhr.statusText);
      });
      document.addEventListener('htmx:sendError', function () {
        show(toast.dataset.networkError);
      });
    })();
  </script>

</body>
</html>
