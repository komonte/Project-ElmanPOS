{{define "content"}}
{{/* Caja (F-11, F-12). Datos: .State (sessions.State: .Register y
     .Session, nil si no hay), .Amount (lo escrito si abrir falló), .Error,
     y con la caja abierta .CloseFields (un closeField por medio) y
     .CloseError (si cerrar falló: el formulario de cierre vuelve abierto). */}}
<header class="mb-8">
  <h1 class="shelf-title">{{t "cash.title"}}</h1>
  <p class="mt-2 text-muted max-w-2xl">{{t "cash.hint"}}</p>
</header>

{{if .Error}}
<div role="alert" class="mb-6 p-4 bg-danger-soft border-l-8 border-danger rounded-sm font-bold">{{.Error}}</div>
{{end}}

{{with .State}}
{{if not .Register}}
<section class="p-6 border-2 border-line rounded-md bg-surface max-w-2xl space-y-4">
  <h2 class="font-display font-bold text-2xl">{{t "cash.no_register_title"}}</h2>
  <p class="text-muted">{{t "cash.no_register_hint"}}</p>
  <form method="post" action="/cash/register">
    <button type="submit" class="btn-primary">{{t "cash.create_register"}}</button>
  </form>
</section>
{{else if .Session}}
<section id="cash-open" class="p-6 border-2 border-line border-l-8 border-l-tag rounded-md bg-surface max-w-2xl space-y-2">
  <h2 class="font-display font-bold text-2xl">{{printf (t "cash.open_title") .Register.Name}}</h2>
  <p>{{printf (t "cash.open_since") (formatTime .Session.OpenedAt)}}</p>
  <p>{{t "cash.opening_amount"}}: <span class="font-bold tabular">{{money .Session.OpeningAmount}}</span></p>
  <p class="pt-2"><a href="/pos" class="btn-primary">{{t "cash.go_sell"}}</a></p>
</section>

{{/* Cierre ciego (F-12): cada medio dice dónde mirar y cuántos cobros hubo,
     nunca cuánto se espera. Enter pasa al medio siguiente (no cierra), y
     cerrar pide confirmar repitiendo lo escrito. */}}
<details id="cash-close" class="mt-8 max-w-2xl border-2 border-line rounded-md bg-surface"{{if $.CloseError}} open{{end}}>
  <summary class="cursor-pointer p-6 font-display font-bold text-2xl">{{t "cash.close_title"}}</summary>
  <form id="cash-close-form" method="post" action="/cash/close" class="px-6 pb-6 space-y-4"
        onsubmit="return cashConfirmClose(this)"
        data-ask="{{t "cash.close_confirm"}}" data-empty="{{t "cash.close_confirm_empty"}}"
        data-final="{{t "cash.close_confirm_final"}}">
    <p class="text-muted">{{t "cash.close_hint"}}</p>
    {{with $.CloseError}}<div role="alert" class="p-4 bg-danger-soft border-l-8 border-danger rounded-sm font-bold">{{.}}</div>{{end}}
    <input type="hidden" name="session_id" value="{{.Session.ID}}">
    {{range $.CloseFields}}
    <div class="p-4 border-2 rounded-md {{if .Invalid}}border-danger{{else}}border-line{{end}}">
      <label for="declared-{{.Method}}" class="field-label text-xl">{{t (printf "pos.method_%s" .Method)}}</label>
      <p id="declared-{{.Method}}-hint" class="text-muted">
        {{t (printf "cash.where_%s" .Method)}}
        {{if eq .Method "CASH"}}{{t "cash.where_cash_float"}} <span class="whitespace-nowrap font-bold text-ink">{{money $.State.Session.OpeningAmount}}</span>.{{end}}
      </p>
      {{if ne .Method "CASH"}}
      <p class="mt-1 font-bold" data-count="{{.Count}}">{{if eq .Count 0}}{{t "cash.count_none"}}{{else if eq .Count 1}}{{t "cash.count_one"}}{{else}}{{printf (t "cash.count_many") .Count}}{{end}}</p>
      {{end}}
      <input type="text" id="declared-{{.Method}}" name="declared_{{.Method}}" value="{{.Typed}}"
             inputmode="decimal" autocomplete="off" placeholder="0" aria-describedby="declared-{{.Method}}-hint"
             data-label="{{t (printf "pos.method_%s" .Method)}}"{{if .Invalid}} aria-invalid="true" autofocus{{end}}
             onkeydown="cashNextField(event, this)" class="field tabular text-xl max-w-xs mt-2">
    </div>
    {{end}}
    <button type="submit" id="cash-close-submit" class="btn-primary text-lg">{{t "cash.close"}}</button>
  </form>
</details>
<script>
  function cashCloseFields(form) {
    return Array.prototype.slice.call(form.querySelectorAll('input[name^="declared_"]'));
  }
  // Enter en un monto pasa al siguiente: contando con el home banking
  // abierto, un Enter de más no tiene que cerrar la caja.
  function cashNextField(e, input) {
    if (e.key !== 'Enter') return;
    e.preventDefault();
    const fields = cashCloseFields(input.form);
    const next = fields[fields.indexOf(input) + 1];
    (next || document.getElementById('cash-close-submit')).focus();
  }
  // Antes de cerrar, repite lo escrito: después no se puede cambiar.
  function cashConfirmClose(form) {
    const lines = cashCloseFields(form).map(function (f) {
      return f.dataset.label + ': ' + (f.value.trim() || form.dataset.empty);
    });
    if (!confirm(form.dataset.ask + '\n\n' + lines.join('\n') + '\n\n' + form.dataset.final)) return false;
    document.getElementById('cash-close-submit').disabled = true;
    return true;
  }
</script>
{{else}}
<section class="p-6 border-2 border-line rounded-md bg-surface max-w-2xl space-y-4">
  <h2 class="font-display font-bold text-2xl">{{printf (t "cash.closed_title") .Register.Name}}</h2>
  <form id="cash-open-form" method="post" action="/cash/open" class="space-y-3">
    <label class="field-label">{{t "cash.opening_amount"}}
      <input type="text" name="opening_amount" inputmode="decimal" autocomplete="off" required
             value="{{$.Amount}}" aria-describedby="cash-opening-hint" autofocus class="field tabular max-w-xs">
    </label>
    <p id="cash-opening-hint" class="field-hint">{{t "cash.opening_hint"}}</p>
    <button type="submit" class="btn-primary">{{t "cash.open"}}</button>
  </form>
</section>
{{end}}
{{end}}
{{end}}
